{
  "name": "copilot-toolbox",
  "version": "1.3.1",
  "private": true,
  "description": "Practical skills for shaping, building, reviewing, and improving software with coding agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/mpkarlo/copilot-toolbox"
  },
  "license": "MIT",
  "scripts": {
    "test:repository-config": "node --test scripts/repository-config.test.mjs",
    "sync:copilot-plugin": "node scripts/sync-copilot-plugin.mjs",
    "check:copilot-plugin": "node scripts/sync-copilot-plugin.mjs --check",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "check-plugin-version": "node scripts/sync-plugin-version.mjs --check"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0"
  },
  "packageManager": "npm@10.9.4"
}
